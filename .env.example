# ─────────────────────────────────────────────────────────────
# drh.al — environment configuration
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=https://drh.al

# ── Supabase ────────────────────────────────────────────────
# Public (safe for the browser — anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="drh.al <noreply@drh.al>"
EMAIL_ADMIN_TO=info@drh.al

# ── Cloudflare Turnstile (spam protection) ──────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Client-side analytics (public by design) ────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Server-side analytics reporting (admin dashboard) ───────
# Google Cloud service account with access to GA4 + Search Console.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key. Keep the \n escapes on one line.
GOOGLE_PRIVATE_KEY=
GA4_PROPERTY_ID=
GSC_SITE_URL=https://drh.al/

# ── Optional ────────────────────────────────────────────────
NEXT_PUBLIC_CALENDLY_URL=
